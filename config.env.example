# Copy to ${XDG_CONFIG_HOME:-~/.config}/notes-interrogator/env (chmod 600).
# Loaded automatically on every notes-interrogator invocation; does not override existing env.

XDG_CONFIG_HOME=/home/you/.config
XDG_DATA_HOME=/home/you/.local/share

MAIL_CLI=/home/you/bin/gog
MAIL_ACCOUNT=you@example.com
MAIL_CLIENT=work

TASKS_CLI=/home/you/bin/gog
TASKS_LIST_ID=your-google-tasks-list-id

LLM_BASE_URL=https://openrouter.ai/api
LLM_MODEL=anthropic/claude-sonnet-4
LLM_API_KEY=your-api-key
